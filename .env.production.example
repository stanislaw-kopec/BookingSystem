# Copy this file to .env.production and replace every example value.
# APP_ADDRESS=:80 keeps a local smoke test on HTTP. A real domain, for example
# workshop.example.com, enables Caddy's automatic HTTPS.
APP_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443

POSTGRES_DB=booking_system
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Used only when no administrator exists yet. Remove these values after the first
# successful start; the existing account is never overwritten.
BOOTSTRAP_ADMIN_USERNAME=portfolio.admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Keep true behind HTTPS. Set false only for an HTTP smoke test on localhost.
SESSION_COOKIE_SECURE=false

# API documentation is disabled by default in the production profile.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
